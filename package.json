{
  "name": "valentine-question",
  "private": true,
  "version": "1.0.0",
  "description": "A cinematic, interactive Valentine's Day proposal experience.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist --nojekyll -m \"Deploy site\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  }
}
